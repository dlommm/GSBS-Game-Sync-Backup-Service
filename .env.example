# Copy to .env and set a long random GSBS_SESSION_SECRET before production use.
# Generate one with: openssl rand -hex 32

GSBS_SESSION_SECRET=change-me-to-a-long-random-string

# Optional server settings (uncomment as needed)
# GSBS_ALLOW_REGISTER=true
# GSBS_ADMIN_USERNAME=admin
# GSBS_LOG_LEVEL=info
# GSBS_PCGW_SYNC_SOURCE=github
# GSBS_PCGW_CRON=0 3 * * 0
# GSBS_PCGW_BUNDLE_CRON=0 4 * * *
# GSBS_PCGW_BUNDLE_URL=https://raw.githubusercontent.com/dlommm/gsbs-manifest/main/manifest.json.gz
