# GSBS runs with NO required environment variables. On first start the server
# generates a session secret into its data volume and opens a web setup wizard
# (create the admin account, pick registration/storage/backup options).
#
# Everything below is OPTIONAL. Set a variable here only to override the wizard
# / Server Settings, or to pin config in a GitOps deployment. An env value
# always wins over the database-stored setting.

# --- Core ---
# GSBS_SESSION_SECRET=            # auto-generated if unset; set to pin (>=32 chars, `openssl rand -base64 32`)
# GSBS_DB=/app/data/gsbs.db
# GSBS_SAVE_ROOT=/app/data/gamesaves
# GSBS_ALLOW_REGISTER=false       # overrides the wizard's registration choice
# GSBS_MAX_STORAGE_BYTES=0        # global storage limit (0 = unlimited)
# GSBS_LOG_LEVEL=info
# GSBS_TRUST_PROXY=1              # trust X-Forwarded-For (only behind a proxy that strips client XFF)

# --- Backups (also configurable in Settings) ---
# GSBS_BACKUP_DIR=/app/data/backups
# GSBS_BACKUP_CRON=0 5 * * *
# GSBS_BACKUP_S3_ENDPOINT=
# GSBS_BACKUP_S3_BUCKET=
# GSBS_BACKUP_S3_ACCESS_KEY=
# GSBS_BACKUP_S3_SECRET_KEY=

# --- Save-location manifest (PCGamingWiki) ---
# GSBS_PCGW_SYNC_SOURCE=github
# GSBS_PCGW_CRON=0 3 * * 0
# GSBS_PCGW_BUNDLE_CRON=0 4 * * *
