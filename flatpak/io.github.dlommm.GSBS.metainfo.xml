<component type="desktop-application">
  <id>io.github.dlommm.GSBS</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>GSBS</name>
  <summary>Sync, back up, and protect your game saves</summary>

  <developer id="io.github.dlommm">
    <name>GSBS Contributors</name>
  </developer>

  <description>
    <p>
      GSBS (Game Sync &amp; Backup Service) keeps your game saves synchronized
      and safely backed up across your devices. A lightweight system-tray app
      watches your save folders and syncs them to your own self-hosted GSBS
      server — sync, backup, protect.
    </p>
    <p>Supported save locations include:</p>
    <ul>
      <li>Steam and Proton (native and Flatpak)</li>
      <li>Heroic Games Launcher, Lutris, and Bottles</li>
      <li>Native Linux game installs and custom folders</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.dlommm.GSBS.desktop</launchable>

  <categories>
    <category>Game</category>
    <category>Utility</category>
  </categories>

  <keywords>
    <keyword>game</keyword>
    <keyword>save</keyword>
    <keyword>backup</keyword>
    <keyword>sync</keyword>
    <keyword>cloud</keyword>
    <keyword>steam</keyword>
    <keyword>proton</keyword>
  </keywords>

